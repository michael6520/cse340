<% if (title) { %>
<h1><%= title %></h1>
<% } else {
  res.redirect('/')
} %>

<%- messages() %>

<% if (errors) { %>
  <ul class="notice">
 <% errors.array().forEach(error => { %>
   <li><%= error.msg %></li>
<%  }) %>
 </ul>
<% } %>

<form class="form" action="/inv/delete" method="post">
  <label for="inv_make">Make</label>
  <input readonly type="text" id="inv_make" name="inv_make" required value="<%= locals.inv_make %>">

  <label for="inv_model">Model</label>
  <input readonly type="text" id="inv_model" name="inv_model" required value="<%= locals.inv_model %>">
    
  <label for="inv_year">Year</label>
  <input readonly type="number" id="inv_year" name="inv_year" required value="<%= locals.inv_year %>">

  <label for="inv_price">Price</label>
  <input readonly type="number" id="inv_price" name="inv_price" required value="<%= locals.inv_price %>">

  <button type="submit">Delete Vehicle</button>
  <p>Confirm Deletion - The delete is permanent.</p>
  <input type="hidden" name="inv_id"
  <% if(locals.inv_id) { %> value="<%= locals.inv_id %>"
  <% } %>>
</form>